# Supabase project URL — found in your Supabase dashboard under Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose to the browser; RLS enforces access
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key — NEVER expose to the browser or commit to git
# Used only in server-side scripts (e.g. running migrations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
